# Portable fixture defaults; source this file before local overrides.
FIXTURE_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
RETROARCH_BIN="${RETROARCH_BIN:-$(command -v retroarch || true)}"
RETROARCH_BASE_CONFIG="${RETROARCH_BASE_CONFIG:-}"
CORE_PATH="${CORE_PATH:-$FIXTURE_ROOT/parallel_n64_libretro.so}"
ROM_PATH="${ROM_PATH:-$FIXTURE_ROOT/assets/Paper Mario (USA).zip}"
STARTUP_WAIT="0"
STARTUP_READY_PATTERN="EmuThread: M64CMD_EXECUTE."
TITLE_START_MASK="0x8"
TITLE_BOOT_WAIT_SECONDS="20"
TITLE_POST_PRESS_WAIT_SECONDS="5"
BOOTSTRAP_STATE_PATH="${BOOTSTRAP_STATE_PATH:-$FIXTURE_ROOT/assets/states/paper-mario-title-screen-save-backed/ParaLLEl N64/Paper Mario (USA).state}"
AUTHORITATIVE_STATE_PATH="${AUTHORITATIVE_STATE_PATH:-$FIXTURE_ROOT/assets/states/paper-mario-file-select-save-backed/ParaLLEl N64/Paper Mario (USA).state}"
POST_LOAD_SETTLE_FRAMES="3"
FILE_SELECT_START_MASK="0x8"
FILE_SELECT_START_HOLD_FRAMES="60"
FILE_SELECT_TARGET_FRAME="303"
FILE_SELECT_POST_PRESS_WAIT_SECONDS="5"
SAVEFILE_PATH="${SAVEFILE_PATH:-$FIXTURE_ROOT/assets/savefiles/paper-mario-local/ParaLLEl N64/Paper Mario (USA).srm}"
EXPECTED_SCREENSHOT_SHA256=""
VERIFY_SELECTED_SLOT_HAS_DATA="true"
