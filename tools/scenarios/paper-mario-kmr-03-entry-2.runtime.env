# Portable fixture defaults; source this file before local overrides.
FIXTURE_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
RETROARCH_BIN="${RETROARCH_BIN:-$(command -v retroarch || true)}"
RETROARCH_BASE_CONFIG="${RETROARCH_BASE_CONFIG:-}"
CORE_PATH="${CORE_PATH:-$FIXTURE_ROOT/parallel_n64_libretro.so}"
ROM_PATH="${ROM_PATH:-$FIXTURE_ROOT/assets/Paper Mario (USA).zip}"
STARTUP_WAIT="0"
STARTUP_READY_PATTERN="EmuThread: M64CMD_EXECUTE."
AUTHORITATIVE_STATE_PATH="${AUTHORITATIVE_STATE_PATH:-$FIXTURE_ROOT/assets/states/paper-mario-kmr-03-entry-2/ParaLLEl N64/Paper Mario (USA).state}"
POST_LOAD_SETTLE_FRAMES="3"
# Import lineage: decompressed M64+SAVE body of the recorded landing-control
# checkpoint. The remint helper reads this pin from this tracked file.
AUTHORITY_SOURCE_STATE_BODY_SHA256="e98271b65bfa81c5f18ceefd10a141eb4e2bc878aa28003783b1b12a82757d2d"
# PENDING: empty until the first runtime remint reports the feature-off
# steady-state digest. Fill it here and in the authority graph node; until then
# the remint helper refuses publication and scenarios skip the digest check.
EXPECTED_SCREENSHOT_SHA256_OFF=""
EXPECTED_INIT_SYMBOL="state_init_world"
EXPECTED_STEP_SYMBOL="state_step_world"
EXPECTED_SCENE_AREA_ID="0"
EXPECTED_SCENE_MAP_NAME="kmr_03"
EXPECTED_SCENE_ENTRY_ID="2"
EXPECTED_HIRES_PROVENANCE_AVAILABLE_OFF="0"
EXPECTED_HIRES_DRAW_USAGE_AVAILABLE_OFF="0"
EXPECTED_HIRES_SUMMARY_PROVIDER_ON="on"
EXPECTED_HIRES_SUMMARY_SOURCE_MODE_ON="phrb-only"
EXPECTED_HIRES_COMPAT_DRAW_HITS_PRESENT_ON="1"
EXPECTED_HIRES_MIN_SUMMARY_SOURCE_PHRB_COUNT_ON="1"
EXPECTED_HIRES_PROVENANCE_AVAILABLE_ON="1"
EXPECTED_HIRES_DRAW_USAGE_AVAILABLE_ON="1"
EXPECTED_HIRES_SAMPLER_USAGE_AVAILABLE_ON="1"
EXPECTED_HIRES_SOURCE_CLASS_PRESENT_ON="authored-rdram"
EXPECTED_HIRES_PROVENANCE_CLASS_PRESENT_ON="copy-cycle,loadtile,loadblock"
EXPECTED_HIRES_DRAW_CLASS_PRESENT_ON="texrect,triangle"
SAVEFILE_PATH=""
